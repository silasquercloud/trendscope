# Copy to .env.local. Never prefix secrets with NEXT_PUBLIC_.
# With all values empty, the dashboard uses honest empty states.
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=
DATABASE_URL=
# Request only approved OAuth scopes; enable YouTube Data API v3.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Requires approved Login Kit + Display API and the documented scopes.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Optional real AI. Requires authenticated users, migrations and API billing.
# Pick an available text model in your OpenAI project. No fallback templates.
OPENAI_API_KEY=
OPENAI_MODEL=

# Optional startup migration, after configuring the three auth/database values.
RUN_DB_MIGRATIONS=0
